{
  "info": {
    "_postman_id": "b3e3a4b2-assign-collection",
    "name": "Express SSE CRUD Assignment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for students CRUD and SSE endpoints"
  },
  "item": [
    {
      "name": "Create student",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"age\": 20,\n  \"course\": \"html\"\n}"
        },
        "url": { "raw": "http://localhost:3000/students", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["students"] }
      },
      "response": []
    },
    {
      "name": "Get all students",
      "request": { "method": "GET", "header": [], "url": { "raw": "http://localhost:3000/students", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["students"] } },
      "response": []
    },
    {
      "name": "Get student by id",
      "request": { "method": "GET", "header": [], "url": { "raw": "http://localhost:3000/students/:id", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["students", ":id"] } },
      "response": []
    },
    {
      "name": "Get student by email",
      "request": { "method": "GET", "header": [], "url": { "raw": "http://localhost:3000/students/email/:email", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["students","email",":email"] } },
      "response": []
    },
    {
      "name": "Get students by course",
      "request": { "method": "GET", "header": [], "url": { "raw": "http://localhost:3000/students/course/:course", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["students","course",":course"] } },
      "response": []
    },
    {
      "name": "Update student",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Name\"\n}" },
        "url": { "raw": "http://localhost:3000/students/:id", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["students", ":id"] }
      },
      "response": []
    },
    {
      "name": "Delete student",
      "request": { "method": "DELETE", "header": [], "url": { "raw": "http://localhost:3000/students/:id", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["students", ":id"] } },
      "response": []
    },
    {
      "name": "SSE time (open in browser)",
      "request": { "method": "GET", "header": [], "url": { "raw": "http://localhost:3000/sse/time", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["sse","time"] } },
      "response": []
    }
  ]
}
